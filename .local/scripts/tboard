#!/usr/bin/env fish
# tboard — split the current tmux window into a 3-pane board.
# Left column 70% holds 2 stacked rows; right column 30% spans full height.
# Optional positional args place a command in each pane (reading order):
#   $1 = top-left   $2 = right (full-height)   $3 = bottom-left
# An empty string ('') or missing arg leaves that pane a bare shell.

if test -z "$TMUX"
    echo "tboard: must be run inside a tmux session" >&2
    exit 1
end

# Capture each pane id as it becomes the active pane during the split
# sequence, so commands can be targeted regardless of pane reindexing.
set tl (tmux display-message -p '#{pane_id}')
tmux split-window -h -l 30%
set r (tmux display-message -p '#{pane_id}')
tmux select-pane -L
tmux split-window -v -l 50%
set bl (tmux display-message -p '#{pane_id}')

# Place optional commands (empty/missing args leave a bare shell).
if test -n "$argv[1]"; tmux send-keys -t $tl "$argv[1]" Enter; end
if test -n "$argv[2]"; tmux send-keys -t $r "$argv[2]" Enter; end
if test -n "$argv[3]"; tmux send-keys -t $bl "$argv[3]" Enter; end

# Focus the top-left pane.
tmux select-pane -t $tl
